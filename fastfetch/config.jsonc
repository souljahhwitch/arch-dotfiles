{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/arch-dotfiles/fastfetch/logo.txt",
        "padding": {
            "top": 1,
            "right": 4
        },
        "printRemaining": true
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "cyan",
            "title": "white"
        },
        "key": {
            "width": 14,
            "type": "icon"
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },

        {
            "type": "custom",
            "format": "────────────────────────────"
        },

        {
            "type": "os",
            "key": "󰣇  OS"
        },
        {
            "type": "host",
            "key": "󰌢  Host"
        },
        {
            "type": "kernel",
            "key": "󰒋  Kernel"
        },
        {
            "type": "uptime",
            "key": "󰅐  Uptime"
        },

        "break",
        {
            "type": "terminal",
            "key": "󰨊  Terminal"
        },
        {
            "type": "wm",
            "key": "󰖯  WM"
        },

        "break",

        {
            "type": "cpu",
            "key": "󰍛  CPU"
        },
        {
            "type": "gpu",
            "key": "󰢮  GPU"
        },
        {
            "type": "memory",
            "key": "󰘚  Memory"
        },
        {
            "type": "disk",
            "key": "󰋊  Disk"
        }
    ]
}
